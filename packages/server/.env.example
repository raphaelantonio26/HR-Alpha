# HR OS server — copy to .env. NO real secrets in source control.
NODE_ENV=development
PORT=8080
# Postgres 16 with row-level security enabled.
DATABASE_URL=postgresql://hros:hros@localhost:5432/hros?schema=public
# App session signing (rotate; never commit a real value).
JWT_SECRET=replace-me-in-env
# Server-side only. The browser NEVER sees this. Absent => AI features degrade to labeled fallback.
ANTHROPIC_API_KEY=
# Async jobs / rate-limit store.
REDIS_URL=redis://localhost:6379
# Object storage for documents (S3/MinIO).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=hros-documents
